ENVIRONMENT=production
SECRET_KEY=replace-with-a-long-random-value
COOKIE_SECURE=false
BUSINESS_TIMEZONE=Asia/Shanghai

POSTGRES_DB=uoj_quiz
POSTGRES_USER=uoj_quiz
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://uoj_quiz:replace-with-url-encoded-password@postgres:5432/uoj_quiz
APP_PORT=8090

# UOJ metadata: use a SELECT-only account in production.
UOJ_DATABASE_URL=mysql+aiomysql://readonly_user:replace-with-url-encoded-password@uoj:3306/app_uoj233?charset=utf8mb4
UOJ_HTTP_BASE_URL=http://uoj
UOJ_JUDGER_NAME=main_judger
UOJ_JUDGER_PASSWORD=replace-with-existing-judger-password
STUDENT_USERNAME_REGEX=^[0-9]+$
# This accepts the same HTTP transport risk as an HTTP-only UOJ deployment.
# Prefer HTTPS when available. Copy the existing UOJ client_salt only into the
# real server .env; never commit it. Raw passwords are never persisted or logged.
UOJ_PASSWORD_AUTH_ENABLED=true
UOJ_PASSWORD_CLIENT_SALT=

# Use mock for offline development, or openai-compatible for DeepSeek.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_REASONING_EFFORT=max
LLM_TIMEOUT_SECONDS=360
LLM_MAX_TOKENS=100000
LLM_MAX_CONCURRENCY=25

# Four backend processes: 20 generation loops each, up to 80 globally.
# The shared per-process LLM ceiling leaves capacity for concurrent grading.
GENERATION_GLOBAL_CONCURRENCY=80
GENERATION_WORKERS=20

# Scores below this confidence require teacher review; no extra model calls.
GRADING_REVIEW_CONFIDENCE_THRESHOLD=0.85

GENERATION_TASK_TIMEOUT_SECONDS=1200

GRADING_WORKERS=4
GRADING_POLL_SECONDS=3
GRADING_TASK_TIMEOUT_SECONDS=1200

QUALITY_AUDIT_ENABLED=false
LIGHTWEIGHT_CREATION_ENABLED=false
QUALITY_AUDIT_TIMEOUT_SECONDS=1200
QUALITY_AUDIT_MAX_TOKENS=100000
